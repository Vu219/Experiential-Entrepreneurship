APP_NAME=

SERVER_PORT=
CONTEXT_PATH=

DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=

APP_TIMEZONE=

JWT_SIGNER_KEY=
JWT_ACCESS_TOKEN_EXPIRATION=
JWT_REFRESH_TOKEN_EXPIRATION=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_CALLBACK_URL=

REDIS_HOST=
REDIS_PORT=
REDIS_SSL_ENABLED=

# email (Brevo Transactional Email API — HTTP/443, không dùng SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Supabase Storage (service_role key is BACKEND ONLY — never expose to the frontend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# AES-256 encryption key for access token storage (32 bytes base64: openssl rand -base64 32)
AIMA_ENCRYPTION_KEY=

# AI service (Python/FastAPI) — content generation
AI_SERVICE_BASE_URL=
AI_SERVICE_TIMEOUT_SECONDS=


AI_SERVICE_BASE_URL=
AI_SERVICE_TIMEOUT_SECONDS=
# AI config theo DB (trang admin "Cấu hình AI"). Mặc định false = giữ hành vi env cũ.
AI_CONFIG_FROM_DB=
# Shared secret backend↔AI service (openssl rand -base64 32) — CÙNG giá trị AI_INTERNAL_TOKEN ở ai/.env
AI_INTERNAL_TOKEN=
# Seed key/model 1 lần từ env (tuỳ chọn — copy từ ai/.env; trống thì admin dán key qua UI)
AI_SEED_ANTHROPIC_API_KEY=
AI_SEED_ANTHROPIC_MODEL=
AI_SEED_GOOGLE_API_KEY=
AI_SEED_GOOGLE_MODEL=

# Meta Social Platform Connections (Facebook / Instagram / Threads)
META_FACEBOOK_APP_ID=
META_FACEBOOK_APP_SECRET=
META_FACEBOOK_REDIRECT_URI=
META_THREADS_APP_ID=
META_THREADS_APP_SECRET=
META_THREADS_REDIRECT_URI=
META_APP_SECRET_PROOF_ENABLED=
FE_OAUTH_SUCCESS_URL=
FE_OAUTH_ERROR_URL=

# Auth cookie (HttpOnly access_token + refresh_token)
# COOKIE_DOMAIN: de trong = khong set Domain (local dev). Khi FE/BE cung domain goc:
#   .aima-marketing.id.vn  -> cookie thanh first-party, Safari/Brave khong chan
COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAME_SITE=
AUTH_COOKIE_PATH=

# Log & retention (LogRetentionJob chay 03:30 hang ngay, hard delete)
# Dat 0 de TAT viec don bang tuong ung.
ACTIVITY_LOG_RETENTION_DAYS=90
SYSTEM_LOG_RETENTION_DAYS=180
USAGE_SUCCESS_RETENTION_DAYS=90
USAGE_ERROR_RETENTION_DAYS=180
# Chong trung activity log: cung userId + action + targetId trong N giay chi ghi 1 lan (0 = tat)
# LOGIN_FAILED duoc MIEN chong trung (tan suat thu sai la du lieu bao mat) -> dung tran theo IP duoi day
ACTIVITY_LOG_DEDUP_SECONDS=60
# Tran so dong/gio cho MOI IP voi action duoc mien dedup (0 = tat)
ACTIVITY_LOG_IP_HOURLY_CAP=100

# ===== Thanh toan goi dich vu (payOS) =====
# Cong thanh toan: mock (dev, khong can credential) | payos (that)
PAYMENT_GATEWAY=mock
# Han cho thanh toan cua don PENDING (phut) — dung chung cho dem nguoc va expiredAt gui payOS
PAYMENT_PENDING_TTL_MINUTES=15
# An han khi cong bao PROCESSING (tien dang chuyen do) — KHONG huy don PROCESSING
PAYMENT_GRACE_MINUTES=10
PAYMENT_MAX_GRACE_ROUNDS=3
# Tran kich thuoc body webhook (byte) — endpoint webhook la public, khong JWT
PAYMENT_WEBHOOK_MAX_BODY_BYTES=16384
# Bao admin khi webhook bi tu choi vi SAI CHU KY qua nhieu trong cua so (phut)
PAYMENT_WEBHOOK_ALERT_THRESHOLD=5
PAYMENT_WEBHOOK_ALERT_WINDOW_MINUTES=10
# DEV-ONLY: kich ban hong ma cong gia lap mo phong (NORMAL | CREATE_TIMEOUT |
# CREATE_SERVER_ERROR | GET_LINK_NOT_FOUND | GET_UNREACHABLE | LINK_EXPIRED)
PAYMENT_MOCK_SCENARIO=NORMAL
# Chu ky quet don TREO (ms) — don PENDING khong co checkout_url khoa cung user khoi viec mua
PAYMENT_RECONCILE_INTERVAL_MS=60000
# Chu ky quet don DA QUA HAN (ms)
PAYMENT_EXPIRY_INTERVAL_MS=60000
# Cron ha goi het han ve Free (6 truong kieu Spring). Mac dinh 00:05 hang ngay.
PAYMENT_PLAN_EXPIRY_CRON=0 5 0 * * *

# payOS — lay o my.payos.vn sau khi tao kenh thanh toan. TUYET DOI khong commit gia tri that.
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Noi payOS dua TRINH DUYET ve — chi de hien thi, query string khong co chu ky
PAYOS_RETURN_URL=http://localhost:3000/billing/return
PAYOS_CANCEL_URL=http://localhost:3000/billing/return?cancel=1
# Tran do dai description (tai lieu payOS: toi da 9 ky tu voi TK chua lien ket payOS)
PAYOS_DESCRIPTION_MAX_LENGTH=9
# Timeout goi payOS (giay). Het timeout = KHONG ket luan duoc -> don giu PENDING +
# reconcile_required, khong set FAILED.
PAYOS_CONNECT_TIMEOUT_SECONDS=5
PAYOS_READ_TIMEOUT_SECONDS=15
